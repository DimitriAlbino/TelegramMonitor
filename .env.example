# TelegramMonitor — example environment.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Every variable here corresponds to a field in tgmonitor/config.py:Settings.

# --- Core ---
# Generate a long random string (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development          # development | production
# Public base URL of the deployment — used for verification/reset email links,
# the Telegram webhook, and the /start reply.
PUBLIC_BASE_URL=http://localhost:8000
# Trust the X-Forwarded-For header for client-IP rate limiting. Enable only when
# the deploy genuinely sits behind a reverse proxy we control (Caddy), so the
# header cannot be spoofed by arbitrary clients.
TRUST_PROXY_HEADERS=false

# --- Database (single Postgres instance with the TimescaleDB extension) ---
POSTGRES_USER=tgmonitor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tgmonitor
DATABASE_URL=postgresql+psycopg://tgmonitor:change-me@db:5432/tgmonitor

# --- Telegram (shared bot) ---
# From @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=123456:AA...change-me
# Secret token WE set when registering the webhook; Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header. Generate with `python -c "import secrets;print(secrets.token_urlsafe(32))"`.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# --- Outbound email (signup verification, password reset) ---
# Any SMTP provider. In dev, leave SMTP_HOST blank to print messages to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
SMTP_FROM_NAME=TelegramMonitor

# --- Auth (sessions + rate limiting) ---
# Sessions (signed JWTs) expire after this many minutes (default ~14 days).
SESSION_EXPIRE_MINUTES=20160
# Sliding-window abuse limits (ADR-0011): per-IP and per-email caps over the window.
AUTH_RATE_WINDOW_S=300
AUTH_RATE_MAX_PER_IP=20
AUTH_RATE_MAX_PER_EMAIL=10

# --- Engine knobs (defaults shown) ---
CHECK_TICK_INTERVAL_S=5          # how often the worker scans for due monitors
CHECK_CONCURRENCY=200            # global in-flight check cap (semaphore)
MIN_CHECK_INTERVAL_S=30          # abuse-prevention floor on monitor.interval
MAX_MONITORS_PER_USER=50         # abuse-prevention cap

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
