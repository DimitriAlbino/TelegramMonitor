# TelegramMonitor — example environment.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# --- Core ---
# Generate a long random string (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development          # development | production

# --- Database (single Postgres instance with the TimescaleDB extension) ---
POSTGRES_USER=tgmonitor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tgmonitor
DATABASE_URL=postgresql+psycopg://tgmonitor:change-me@db:5432/tgmonitor

# --- Telegram (shared bot) ---
# From @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=123456:AA...change-me
# Public base URL where Telegram can reach our webhook, e.g. https://monitor.example.com
TELEGRAM_WEBHOOK_PUBLIC_URL=https://monitor.example.com
# Secret token WE set when registering the webhook; Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header. Generate with `python -c "import secrets;print(secrets.token_urlsafe(32))"`.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# --- Outbound email (signup verification, password reset) ---
# Any SMTP provider. In dev, leave blank to print messages to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@monitor.example.com

# --- Telegram Login Widget (optional at launch; see ADR-0001) ---
# Obtained from @BotFather when configuring the login widget for the bot.
TELEGRAM_LOGIN_BOT_NAME=
TELEGRAM_LOGIN_PROVIDER_TOKEN=

# --- Engine knobs (defaults shown) ---
CHECK_TICK_INTERVAL_S=5          # how often the worker scans for due monitors
CHECK_CONCURRENCY=200            # global in-flight check cap (semaphore)
MIN_CHECK_INTERVAL_S=30          # abuse-prevention floor on monitor.interval
MAX_MONITORS_PER_USER=50         # abuse-prevention cap

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
